#!/usr/bin/env bash
# Refuses a push to the public repo that would republish the history the rewrite removed. Old local
# branches and worktrees still sit on that history, and one push of one of them would publish it all
# again.
#
# It refuses a push when a commit that origin does not have yet has an author or committer email
# other than the one git config user.email gives for this repo: the rewritten history keeps the old
# addresses, and every new commit uses the configured noreply address. The old addresses are not
# named here, so this file can be public.
# It only checks pushes to origin. Install: scripts/git-hooks/install.sh
set -euo pipefail
remote=$1
[[ $remote == origin ]] || exit 0
zero=0000000000000000000000000000000000000000
email=$(git config user.email)
[[ -n $email ]] || { echo "pre-push: no git config user.email; set it (scripts/git-hooks/install.sh)" >&2; exit 1; }
fail=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  # awk reads all input (no early exit): with pipefail, closing the pipe would SIGPIPE rev-list and hide a match.
  if git rev-list "$local_sha" --not --remotes=origin --format='%ae %ce' |
       awk -v e="$email" '$1 ~ /@/ && ($1 != e || $2 != e) { bad = 1 } END { exit !bad }'; then
    echo "pre-push: $local_ref has commits from the pre-rewrite history." >&2
    echo "pre-push: rebase it onto origin (the rewrite commit map maps old to new SHAs)." >&2
    fail=1
  fi
done
exit $fail
